<h1>maquina_stream — harness</h1>

<p>
  Fixture for the keyboard, screen reader and clipboard passes. Every control on
  this page is the real one; nothing here is stubbed.
</p>

<nav>
  <p>
    Fixture text:
    <a href="/harness/repair">repair</a> ·
    <a href="/harness/deferred">deferred</a> ·
    <a href="/harness/reveal">reveal</a> ·
    <a href="/history">history</a>
  </p>
  <p>
    A real model, over the cable:
    <a href="/harness/chat">chat (ruby_llm)</a> ·
    <a href="/harness/agent">agent (nexo_ai)</a>
    — these need <code>config/llm.yml</code>; the page says so if it is missing.
  </p>
</nav>

<section id="static"
         data-controller="ms-link-safety"
         data-action="click->ms-link-safety#intercept">
  <h2>Sealed message</h2>
  <div id="ms-msg-harness"><%= @html %></div>

  <dialog data-ms-link-safety-target="dialog" aria-labelledby="link-safety-title">
    <h3 id="link-safety-title"><%= t("maquina_stream.link_safety.title", default: "Leave this site?") %></h3>
    <p data-ms-link-safety-target="url"></p>
    <label>
      <input type="checkbox" data-ms-link-safety-target="remember">
      <%= t("maquina_stream.link_safety.remember", default: "Trust this site") %>
    </label>
    <button type="button" data-action="ms-link-safety#confirm"><%= t("maquina_stream.link_safety.confirm", default: "Continue") %></button>
    <button type="button" data-action="ms-link-safety#cancel"><%= t("maquina_stream.link_safety.cancel", default: "Cancel") %></button>
  </dialog>
</section>

<section id="streaming">
  <h2>Streaming message (controls must be inert)</h2>
  <%# data-ms-streaming is the host's signal, stamped from maquina_stream_open? %>
  <div id="ms-msg-streaming" data-ms-streaming><%= @streaming_html %></div>
  <button type="button" id="seal-it">Seal it</button>
</section>

<script type="module">
  // Sealing removes the attribute; the stream guard re-enables the controls.
  document.getElementById("seal-it").addEventListener("click", () => {
    document.getElementById("ms-msg-streaming").removeAttribute("data-ms-streaming")
  })
</script>

<section id="autoscroll">
  <h2>Autoscroll</h2>
  <div id="scroller"
       data-controller="ms-autoscroll"
       data-action="scroll->ms-autoscroll#track wheel->ms-autoscroll#release touchmove->ms-autoscroll#release">
    <div id="scroller-content"><p>Initial content.</p></div>
  </div>
  <button type="button" id="append-line">Append a line</button>
</section>

<script type="module">
  // Drives the autoscroll pane the way a stream would, so a person can scroll
  // up mid-stream and watch whether it fights them.
  document.getElementById("append-line").addEventListener("click", () => {
    const p = document.createElement("p")
    p.textContent = `Line ${document.querySelectorAll("#scroller-content p").length}`
    document.getElementById("scroller-content").append(p)
  })
</script>

<section id="deferred">
  <h2>Deferred renderer sanitization</h2>
  <p>
    A stub renderer that returns hostile markup, so the client-side scrub can be
    verified independently of the server's sanitizer — the payload is model
    output and the library is third-party, and neither is a reason to trust what
    comes back.
  </p>
  <div id="hostile"
       data-controller="ms-hostile"
       data-ms-hostile-payload-value='{"source":"graph TD"}'
       data-ms-hostile-eager-value="true">
    <div data-ms-hostile-target="output"></div>
  </div>
</section>

<script type="module">
  import MsDeferredController from "maquina_stream/controllers/ms_deferred_controller"

  // Stands in for a renderer library that returns something hostile.
  class HostileRenderer extends MsDeferredController {
    async draw() {
      return `
        <svg onload="window.__pwned = true">
          <script>window.__pwned = true<\/script>
          <foreignObject><iframe src="javascript:window.__pwned=true"></iframe></foreignObject>
          <a href="javascript:window.__pwned=true">click</a>
          <a href="https://example.com/ok">safe</a>
          <path d="M0 0 L10 10" fill="red" style="behavior:url(x)"></path>
          <text>rendered</text>
        </svg>`
    }
  }

  window.Stimulus.register("ms-hostile", HostileRenderer)
</script>
