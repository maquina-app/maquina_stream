<%# EXTRACTION CANDIDATE → maquina_components. See docs/component-scope.md %>
<%# locals: (lang: nil, source: "", highlighted: nil, variant: :default, size: :md, css_classes: "", **html_options) %>
<%#
  The DOM contract lives in docs/api-surface.md and is fixed:

    <div data-ms-code data-ms-code-lang="ruby">
      <pre><code>…highlighted…</code></pre>
      <pre hidden data-ms-code-source>…raw source…</pre>
    </div>

  This partial does not highlight. `highlighted` arrives already marked up by
  the render pipeline (Rouge, server strategy) and is nil while the fence is
  still open, in which case the plain source renders instead — highlighting an
  open fence is wasted work on every frame.
%>
<%
  lang        ||= nil
  source      = source.to_s
  highlighted = local_assigns.fetch(:highlighted, nil)
  variant     ||= :default
  size        ||= :md

  attributes = component_html_options(
    html_options,
    own_data: {
      component: "code-block",
      variant: variant,
      size: size,
      ms_code_lang: lang.presence
    },
    css_classes: css_classes,
    base_classes: "ms-code-block relative my-4 overflow-hidden rounded-lg border border-gray-200 bg-gray-50 text-sm dark:border-gray-800 dark:bg-gray-900"
  )
%>
<div data-ms-code <%= tag.attributes(attributes) %>>
  <% if lang.present? %>
    <div data-code-block-part="header" class="flex items-center justify-between border-b border-gray-200 px-3 py-1.5 text-xs text-gray-500 dark:border-gray-800 dark:text-gray-400">
      <span data-code-block-part="lang"><%= lang %></span>
    </div>
  <% end %>

  <pre data-code-block-part="pre" class="overflow-x-auto p-3"><code data-code-block-part="code" class="font-mono"><%= highlighted.present? ? highlighted : source %></code></pre>
  <pre hidden data-ms-code-source><%= source %></pre>
</div>
